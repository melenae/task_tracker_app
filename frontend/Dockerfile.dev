FROM node:18-alpine

WORKDIR /app

# Копируем только package файлы сначала для кэширования слоя
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем остальные файлы (node_modules уже установлены, поэтому не копируются)
COPY . .

EXPOSE 3000

# Используем переменную окружения для предотвращения открытия браузера
ENV BROWSER=none

CMD ["npm", "start"]

